  "views": [
    {
      "name": "All Accounts",
      "isDefault": true,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": null,
      "sort": null
    },
    {
      "name": "All Locked Accounts",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "field": "Locked__s",
        "comparator": "equal",
        "value": true
      },
      "sort": null
    },
    {
      "name": "My Accounts",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website"],
      "criteria": {
        "field": "Owner",
        "comparator": "equal",
        "value": {
          "token": "CURRENTUSER"
        }
      },
      "sort": null
    },
    {
      "name": "New Last Week",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "field": "Created_Time",
        "comparator": "equal",
        "value": {
          "token": "PERIOD",
          "name": "PREVIOUS_WEEK"
        }
      },
      "sort": null
    },
    {
      "name": "New This Week",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "field": "Created_Time",
        "comparator": "equal",
        "value": {
          "token": "PERIOD",
          "name": "THIS_WEEK"
        }
      },
      "sort": null
    },
    {
      "name": "Recently Created Accounts",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "groupOperator": "and",
        "group": [
          {
            "field": "Common_Status",
            "comparator": "contains",
            "value": "c"
          },
          {
            "field": "Created_Time",
            "comparator": "less_equal",
            "value": {
              "token": "AGEINDAYS",
              "offset": 31
            }
          }
        ]
      },
      "sort": null
    },
    {
      "name": "Recently Modified Accounts",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "groupOperator": "and",
        "group": [
          {
            "field": "Common_Status",
            "comparator": "contains",
            "value": "m"
          },
          {
            "field": "Modified_Time",
            "comparator": "less_equal",
            "value": {
              "token": "AGEINDAYS",
              "offset": 31
            }
          }
        ]
      },
      "sort": null
    },
    {
      "name": "Unread Accounts",
      "isDefault": false,
      "systemDefined": true,
      "columns": ["Account_Name", "Phone", "Website", "Owner"],
      "criteria": {
        "field": "Common_Status",
        "comparator": "not_contains",
        "value": "v"
      },
      "sort": null
    }
  ],
