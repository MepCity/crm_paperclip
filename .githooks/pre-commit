#!/bin/sh
# Reject commits whose staged paths or added lines contain banned terms.
ROOT=$(git rev-parse --show-toplevel)
BANNED=$(sh "$ROOT/.githooks/banned.sh")
HITS_PATHS=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei "$BANNED")
HITS_LINES=$(git diff --cached -U0 --diff-filter=ACMR --no-ext-diff -- . ':(exclude).githooks/banned.sh' | grep -E '^\+[^+]' | grep -Ei "$BANNED" | head -5)
if [ -n "$HITS_PATHS$HITS_LINES" ]; then
  echo "pre-commit: BLOCKED — staged changes contain a banned term (see AGENTS.md absolute rule 1)." >&2
  [ -n "$HITS_PATHS" ] && echo "  paths:" >&2 && echo "$HITS_PATHS" | sed 's/^/    /' >&2
  [ -n "$HITS_LINES" ] && echo "  lines:" >&2 && echo "$HITS_LINES" | cut -c1-160 | sed 's/^/    /' >&2
  echo "  Reword it as 'reference CRM' and remove absolute paths or account ids." >&2
  exit 1
fi
exit 0
