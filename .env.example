# Copy to .env.local (pnpm dev generates it on first run). Never commit .env.local.

# PostgreSQL 18 connection string. Leave unset to use the embedded local PostgreSQL
# (data in .data/postgres, started and stopped by `pnpm dev`).
# DATABASE_URL=postgres://user:password@localhost:5432/crm

# Dedicated restricted crm_app connection for configuration definitions.
# Never reuse DATABASE_URL or an owner/auth role here. See docs/ops/configuration-definitions.md.
# CRM_DATABASE_URL=postgres://crm_app:password@localhost:5432/crm

# Bounds of each database pool (defaults shown). A caller that cannot get a connection within
# the checkout timeout fails instead of waiting forever; 0 disables a server-side timeout.
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Port for `pnpm dev`. Unset: 3000, or the next free port if it is taken.
# PORT=3000

# Public app URL. `pnpm dev` and the end-to-end runner set this from their port.
# APP_URL=http://127.0.0.1:3000

# Secret for signing authentication cookies. `pnpm dev` generates a random
# value on first run. Set a unique value of at least 32 characters in deployments.
APP_SECRET=

# SecretBox key ring for envelope encryption of secrets at rest (Module 10+, ADR 0009).
# Comma-separated list of `keyId:base64Key` pairs (each key must be 32 bytes base64-encoded).
# SECRET_BOX_KEYS=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Active key id used for sealing new secrets (must exist in SECRET_BOX_KEYS).
# SECRET_BOX_ACTIVE_KEY_ID=k1
